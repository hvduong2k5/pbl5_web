# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# MQTT Configuration
MQTT_BROKER=ssl://your_mqtt_broker_url:8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# MinIO Configuration
MINIO_URL=http://your_minio_url:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=your_bucket_name

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_long_enough
JWT_EXPIRATION=8640000000
MQTT_TOPIC_SUBSCRIBE=your_topic_subscribe
MQTT_TOPIC_PUBLISH=your_topic_publish